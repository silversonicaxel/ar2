---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/format';
import { readingTime } from '../../utils/readingTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const slugOf = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-/, '');
---

<BaseLayout
  title="blog - axel"
  description="Write-ups of implementations, experiments and migrations by Alessandro Rabitti."
>
  <div class="blog">
    <h1 class="content">blog</h1>

    <div class="intro content">
      Write-ups of things I build: implementations, migrations and experiments.
    </div>

    {posts.map((post) => (
      <article class="post content">
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span> · {readingTime(post.body)} min read</span>
          {post.data.stack.length > 0 && (
            <span> · {post.data.stack.map((tech) => `[${tech}]`).join(' ')}</span>
          )}
        </div>
        <h2><a href={`/blog/${slugOf(post.id)}/`}>{post.data.title}</a></h2>
        <p class="desc">{post.data.description}</p>
      </article>
    ))}

    {posts.length === 0 && <div class="intro content">Nothing here yet. Soon.</div>}
  </div>
</BaseLayout>
