---
import BaseLayout from '../layouts/BaseLayout.astro';
import { personSchema, websiteSchema } from '../utils/schema';

const mainSkills = [
  'Javascript',
  'Typescript',
  'ES6',
  'React',
  'Next.js',
  'Node.js',
  'HTML5',
  'CSS3',
  'Tailwind',
  'Vitest',
  'Jest',
  'Playwright',
  'Cypress'
];

const goodSkills = ['Angular', 'Vue.js', 'bash', 'Python', 'MapLibre'];

const agileSkills = [
  'Kanban',
  'Scrum',
  'Problem solver',
  'Feedback promoter',
  'Coaching',
  'Knowledge sessions promoter'
];

const curiositySkills = ['Docker', 'QGIS'];

const extraInterests = [
  'music',
  'art',
  'concerts',
  'museums',
  'exhibitions',
  'formula1',
  'psychology',
  'health'
];

const year = new Date().getFullYear();
---

<BaseLayout
  title="axel - Alessandro Rabitti"
  description="Alessandro Rabitti, Senior Frontend Engineer. Frontend touches and Backend magic with React, Next.js, TypeScript and AI."
  schema={[websiteSchema, personSchema]}
>
  <div class="home">
    <h1 class="content">axel</h1>

    <div class="text content">
      I am Alessandro Rabitti, an Italian Senior Frontend Engineer.
    </div>

    <div class="separator" style="background-image: url('/images/1-ai.jpg')"></div>

    <div class="text content">
      I build robust applications based on modern stack and I love to check the evolution of the technologies.
    </div>

    <div class="text content">
      My focus is on writing simple, modular and functional <code>`code`</code>, from smaller to larger projects.
    </div>

    <div class="text content">
      I appreciate the logic and technical aspects of the applications I work for.
    </div>

    <div class="separator" style="background-image: url('/images/2-office.jpg')"></div>

    <div class="text content">
      I love to be involved in ambitious and challenging projects where I can offer solutions and
      creativity.
    </div>

    <div class="text content">
      I get inspired by working with amazing and open-minded colleagues.
    </div>

    <div class="separator" style="background-image: url('/images/3-keyboard.jpg')"></div>

    <div class="text content">
      I believe AI can be a powerful enabler of continuous improvement, more efficient collaboration, and smarter workflows. I also support Agile methodologies and their values.
    </div>

    <div class="text content">
      I see AI as an opportunity to empower teams and improve the way we work. I feel motivated to help drive Agile transformation, fostering collaboration and adaptability.
    </div>

    <div class="separator" style="background-image: url('/images/4-code.jpg')"></div>

    <div class="text content skills">
      <h2><span aria-hidden="true">&#123;</span>main<span aria-hidden="true">&#125;</span></h2>
      {mainSkills.map((skill) => <span>{skill}&nbsp;</span>)}
    </div>

    <div class="text content skills">
      <h2><span aria-hidden="true">&#123;</span>good<span aria-hidden="true">&#125;</span></h2>
      {goodSkills.map((skill) => <span>{skill}&nbsp;</span>)}
    </div>

    <div class="text content skills">
      <h2><span aria-hidden="true">&#123;</span>agile<span aria-hidden="true">&#125;</span></h2>
      {agileSkills.map((skill) => <span>{skill}&nbsp;</span>)}
    </div>

    <div class="text content skills">
      <h2><span aria-hidden="true">&#123;</span>curious<span aria-hidden="true">&#125;</span></h2>
      {curiositySkills.map((skill) => <span>{skill}&nbsp;</span>)}
    </div>

    <div class="separator" style="background-image: url('/images/5-statue.jpg')"></div>

    <div class="text content skills">
      <h2><span aria-hidden="true">&#123;</span>and<span aria-hidden="true">&#125;</span></h2>
      {extraInterests.map((interest) => <span>{interest}&nbsp;</span>)}
    </div>

    <div class="separator" style="background-image: url('/images/6-contacts.jpg')"></div>

    <div class="text content" id="contact">
      Interested in having a chat? writeme AT alessandrorabitti DOT com.
    </div>

    <div class="text content"><a href="/media/CV-AR-EN.pdf" target="_blank" rel="noopener">CV</a></div>

    <div class="text content">
      <a href="https://www.linkedin.com/in/alessandrorabitti/" target="_blank" rel="noopener">LinkedIn</a>
    </div>

    <div class="text content">
      <a href="https://github.com/silversonicaxel" target="_blank" rel="noopener">github</a>
    </div>

    <div class="text content"><a href="mailto:writeme@alessandrorabitti.com">mail</a></div>

    <footer>
      <p>© copyright <a href="https://alessandrorabitti.com">alessandrorabitti.com</a> {year}</p>
      <br />
      <p>~~ thanks Alba &amp; Alfredo ~~</p>
    </footer>
  </div>
</BaseLayout>
