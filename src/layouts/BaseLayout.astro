---
import '../styles/global.css';
import FullscreenMenu from '../components/FullscreenMenu.astro';
import fontUrl from '../assets/fonts/ShareTech-Regular.woff2';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title="axel - blog" href="/rss.xml" />
    <!-- Google Analytics, same measurement id as the old site -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-81KW2717WH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-81KW2717WH');
    </script>
  </head>
  <body>
    <div class="gradient" aria-hidden="true"></div>
    <FullscreenMenu />
    <main class="page">
      <slot />
    </main>
    <script>
      // cursor-following gradient position; the gradient itself is
      // CSS-gated to hover-capable devices and starts centered
      window.addEventListener(
        'mousemove',
        (event) => {
          document.documentElement.style.setProperty(
            '--gradient-position',
            `${event.clientX}px ${event.clientY}px`
          );
        },
        { passive: true }
      );
    </script>
  </body>
</html>
